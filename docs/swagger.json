{
    "swagger": "2.0",
    "info": {
        "description": "API для управления пользователями и синхронизации событий.",
        "title": "GophKeeper API",
        "contact": {},
        "version": "1.0.0"
    },
    "paths": {
        "/api/event": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Отправляет клиенту события синхронизации.",
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "sync"
                ],
                "summary": "Отправить событие синхронизации",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Идентификатор устройства",
                        "name": "device-id",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Поток событий в формате SSE (data: message\\n\\n)",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Отсутствует заголовок device-id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Неавторизованный доступ",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/pull": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Принимает версии от клиента и возвращает секреты, которые необходимо обновить",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "secrets"
                ],
                "summary": "Получить секреты, требующие обновления",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Идентификатор устройства",
                        "name": "device-id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Версии секретов на клиенте",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SecretVersions"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список зашифрованных секретов",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.CipherData"
                            }
                        }
                    },
                    "204": {
                        "description": "Нет секретов для обновления"
                    },
                    "400": {
                        "description": "Невалидный JSON",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Неавторизованный доступ",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "415": {
                        "description": "Неверный Content-Type",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервиса",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/push": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Принимает журнал изменений от клиента и применяет его на сервере",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "secrets"
                ],
                "summary": "Отправить журнал изменений",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Уникальный идентификатор устройства клиента",
                        "name": "device-id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Журнал изменений секретов",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Changelog"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Изменения успешно применены"
                    },
                    "400": {
                        "description": "Невалидный JSON или отсутствует заголовок device-id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Неавторизованный доступ",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "415": {
                        "description": "Неверный Content-Type",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервиса",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/login": {
            "post": {
                "description": "Проверяет логин и хэш пароля. Возвращает JWT-токен в заголовке Authorization и соль пользователя в теле ответа.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "Аутентификация пользователя",
                "parameters": [
                    {
                        "description": "Логин и хеш пароля",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.LoginPassword"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Соль для дальнейшей аутентификации на клиенте\" {header} string Authorization \"Bearer JWT-токен",
                        "schema": {
                            "$ref": "#/definitions/models.AuthSalt"
                        }
                    },
                    "400": {
                        "description": "Неверные данные или пустые обязательные поля",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Пользователь не найден или неверный пароль",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/register": {
            "post": {
                "description": "Создает новый аккаунт пользователя и возвращает токен авторизации",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "Регистрация нового пользователя",
                "parameters": [
                    {
                        "description": "Данные регистрации (login, hash, salt)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.RegisterUser"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешная регистрация, токен возвращается в заголовке Authorization"
                    },
                    "400": {
                        "description": "Неверные входные данные или пустой логин/пароль",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "Логин уже занят другим пользователем",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера при обработке регистрации",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/salt": {
            "get": {
                "description": "Используется клиентом перед авторизацией, чтобы узнать соль пользователя",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "Получить соль пользователя по логину",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Логин пользователя",
                        "name": "login",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Соль пользователя",
                        "schema": {
                            "$ref": "#/definitions/models.AuthSalt"
                        }
                    },
                    "400": {
                        "description": "Отсутствует или пустой query-параметр login",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.LoginPassword": {
            "type": "object",
            "properties": {
                "hash": {
                    "type": "string",
                    "example": "$argon2id$v=19$m=65536,t=3,p=2$J/gjOEdE2a3CReVybKk0KA$w060F3W2YnO2S/tL5v7rSwGgAn9/k08Y6M1o4L3s7uE"
                },
                "login": {
                    "type": "string",
                    "example": "user"
                }
            }
        },
        "models.AuthSalt": {
            "type": "object",
            "properties": {
                "salt": {
                    "description": "Salt содержит соль.",
                    "type": "string",
                    "example": "8f3b14427a2e4b41a6e52276537af353"
                }
            }
        },
        "models.Changelog": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "ID содержит идентификатор записи.",
                    "type": "integer",
                    "example": 15
                },
                "secret": {
                    "description": "Secret содержит зашифрованные данные секрета.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.CipherData"
                        }
                    ]
                },
                "secret_id": {
                    "description": "SecretID содержит строковый идентификатор секрета.",
                    "type": "string",
                    "example": "8f3b1442-7a2e-4b41-a6e5-2276537af353"
                }
            }
        },
        "models.CipherData": {
            "type": "object",
            "properties": {
                "cipher": {
                    "description": "Cipher определяет зашифрованное содержимое секрета.",
                    "type": "string",
                    "example": "eyJudW1iZXIiOjQyNDIsImRhdGUiOiIxMi8yNiIsInVzZXJfbmFtZSI6IlVzZXJOYW1lIiwia2V5IjoiMTIzIn0="
                },
                "deleted": {
                    "description": "Deleted содержит флаг, указывающий на удаление секрета.",
                    "type": "boolean",
                    "example": false
                },
                "id": {
                    "description": "ID содержит уникальный идентификатор секрета.",
                    "type": "string",
                    "example": "8f3b1442-7a2e-4b41-a6e5-2276537af353"
                },
                "type": {
                    "description": "Type определяет тип секретных данных",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.SecretType"
                        }
                    ],
                    "example": "card"
                },
                "updated_at": {
                    "description": "UpdatedAt содержит время последнего обновления записи.",
                    "type": "string",
                    "example": "2026-11-03T15:00:00Z"
                },
                "version": {
                    "description": "Version содержит текущую версию секрета.",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "models.RegisterUser": {
            "type": "object",
            "properties": {
                "hash": {
                    "description": "Hash содержит хеш пароля.",
                    "type": "string",
                    "example": "$argon2id$v=19$m=65536,t=3,p=2$J/gjOEdE2a3CReVybKk0KA$w060F3W2YnO2S/tL5v7rSwGgAn9/k08Y6M1o4L3s7uE"
                },
                "login": {
                    "description": "Login содержит логин пользователя.",
                    "type": "string",
                    "example": "user"
                },
                "salt": {
                    "description": "Salt содержит соль.",
                    "type": "string",
                    "example": "8f3b14427a2e4b41a6e52276537af353"
                }
            }
        },
        "models.SecretType": {
            "type": "string",
            "enum": [
                "login/password",
                "text",
                "binary",
                "card"
            ],
            "x-enum-varnames": [
                "TypeLoginPassword",
                "TypeText",
                "TypeBinary",
                "TypeCard"
            ]
        },
        "models.SecretVersions": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/models.VersionTime"
            }
        },
        "models.VersionTime": {
            "type": "object",
            "properties": {
                "updated_at": {
                    "description": "UpdatedAt содержит время последнего обновления.",
                    "type": "string",
                    "example": "2026-11-03T15:00:00Z"
                },
                "version": {
                    "description": "Version содержит номер версии.",
                    "type": "integer",
                    "example": 1
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите токен в формате: Bearer \u003cjwt_token\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}